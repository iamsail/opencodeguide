# TypeScript incremental build cache
*.tsbuildinfo

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local env files
.env*.local

# Vercel
.vercel
node_modules/
.next/

# docs-sync 翻译缓存与运行报告（.upstream/ 入库作为 diff 基线）
.translation-cache/
SYNC_REPORT.md

# 生成的 SQL / 临时产物
.tmp/

# Stripe 资源 ID 映射（本地幂等用，含 test/live 环境相关 id）
content/courses/stripe-products.json

# Cloudflare Worker 本地状态与本地密钥（workers/course-delivery）
.wrangler/
.dev.vars
.dev.vars.*
# 模板要入库，否则新克隆不知道要填哪些变量
!.dev.vars.example
workers/**/.wrangler/

