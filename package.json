{
  "name": "opencodeguide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3012",
    "build": "node scripts/build-search.mjs && node scripts/courses/validate-courses.mjs && next build && node scripts/courses/assert-no-gated-content.mjs",
    "build:members": "node scripts/courses/build-members.mjs",
    "start": "next start",
    "lint": "next lint",
    "docs:sync": "node scripts/docs-sync/run.mjs",
    "docs:sync:check": "node scripts/docs-sync/run.mjs --dry-run",
    "docs:validate": "node scripts/docs-sync/validate.mjs",
    "courses:stripe": "node scripts/courses/stripe-payment-links.mjs",
    "courses:stripe:dry": "node scripts/courses/stripe-payment-links.mjs --dry-run",
    "courses:validate": "node scripts/courses/validate-courses.mjs",
    "courses:backfill": "node scripts/courses/backfill-entitlements.mjs",
    "courses:assert": "node scripts/courses/assert-no-gated-content.mjs",
    "workers:test": "cd workers/course-delivery && node --test",
    "courses:meta": "node scripts/courses/sync-course-meta.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "latest",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.4.3",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.21.0",
    "tailwind-merge": "^2.2.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "globby": "^16.1.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0"
  }
}
