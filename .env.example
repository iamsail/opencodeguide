# ---------------------------------------------------------------------------
# 课程板块环境变量
# ---------------------------------------------------------------------------

# Stripe 密钥：只在本地/CI 运行 scripts/courses/stripe-payment-links.mjs 时使用，
# 千万不要加 NEXT_PUBLIC_ 前缀，也不要提交到仓库。
STRIPE_SECRET_KEY=

# 可选：手动覆盖某个课程计划的支付链接。优先级高于 content/courses/stripe-links.json。
# 命名规则：STRIPE_LINK_<SLUG>_<PLAN>（全部大写，非字母数字替换为下划线）
# STRIPE_LINK_AI_CODING_WORKFLOW_SINGLE=https://buy.stripe.com/...
# STRIPE_LINK_AI_CODING_WORKFLOW_PRO=https://buy.stripe.com/...
# STRIPE_LINK_INDIE_SAAS_LAUNCH_SINGLE=https://buy.stripe.com/...
# STRIPE_LINK_ALL_ACCESS_ALL_ACCESS=https://buy.stripe.com/...

# 等待名单收集端点（可选）：Formspree / Buttondown / 自建 Cloudflare Worker。
# 未配置时，等待名单表单会跳转到 /contact。
# 该变量会被内联进前端包，修改后需要重新构建。
# NEXT_PUBLIC_COURSE_WAITLIST_ENDPOINT=

# 购买入口模式（可选，默认 learn）：
#   learn  → 跳成员站 /buy/<slug>/<plan>，强制先 Google 登录，权益绑定登录邮箱
#   stripe → 直连 Stripe Payment Link（旧行为，仅应急回退；买家可不登录，权益绑 Stripe 填的邮箱）
# 两个变量都会被内联进前端包，修改后需要重新构建。
# NEXT_PUBLIC_CHECKOUT_MODE=learn
# NEXT_PUBLIC_LEARN_URL=https://learn.opencodeguide.com

# 已有：Google Analytics（可选）
# NEXT_PUBLIC_GA_ID=
